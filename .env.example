# AdmitPerf environment — copy to .env and edit. Never commit .env.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Everything here is OPTIONAL. With no .env at all you can run the whole tool
# against scripts/fake_vllm.py, and you can deploy an ungated model to Modal
# using only your existing `modal setup` credentials.

# ---------------------------------------------------------------------------
# Modal (only for `admitperf infra up`)
# ---------------------------------------------------------------------------

# Authentication normally lives in ~/.modal.toml after `modal setup`, and these
# are not needed. Set them only for CI or a machine where you cannot run the
# interactive setup.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# Name of a Modal secret containing HF_TOKEN, for GATED weights only
# (Llama, Gemma). Ungated models — Qwen, Mistral, Phi — need nothing here.
#
#   modal secret create huggingface HF_TOKEN=hf_xxx
#   ADMITPERF_HF_SECRET=huggingface
#
# Note this is the *name of a Modal secret*, not the token itself. The token
# must not be put in this file: it would be baked into the deploy environment.
# ADMITPERF_HF_SECRET=huggingface

# ---------------------------------------------------------------------------
# Engine defaults
# ---------------------------------------------------------------------------
# The CLI flags on `admitperf infra up` set these; the variables exist so the
# Modal app can read them at deploy time. Override only if you are invoking
# `modal deploy` on src/admitperf/infra/modal_app.py by hand.

# ADMITPERF_MODEL=Qwen/Qwen3-0.6B
# ADMITPERF_GPU=A10G
# ADMITPERF_SERVED_NAME=lab

# The concurrency cap, and the most consequential setting here. It is small on
# purpose: it is the bottleneck that creates queueing, and without queueing
# every admission policy scores identically because the fleet never saturates.
# Raise it only if you also raise --rate enough to saturate the larger limit.
# ADMITPERF_MAX_NUM_SEQS=8

# ADMITPERF_MAX_MODEL_LEN=16384
# ADMITPERF_GPU_MEM_UTIL=0.90

# ---------------------------------------------------------------------------
# Local / bring-your-own engine
# ---------------------------------------------------------------------------
# If you already run vLLM somewhere (a Lambda box, a local GPU), skip
# provisioning entirely and pass the URL per command instead:
#
#   admitperf smoke --engine-url http://127.0.0.1:8000
#   admitperf run --policy kv_threshold --engine-url http://127.0.0.1:8000
