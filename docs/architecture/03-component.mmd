%% C4 Level 3 — Component Diagram
%% What lives inside the Core container. Green boxes exist; grey boxes are planned.
flowchart TB

  cli(["CLI<br/><i>admitperf run</i>"])

  subgraph CORE["<b>Core</b> container - the shared decision path"]
    direction TB

    api["<b>Adapter API v0</b><br/><i>src/admitperf/policies/base.py</i><br/>Request · SystemState · Decision<br/>AdmissionPolicy protocol"]

    registry["<b>Policy registry</b><br/><i>src/admitperf/policies/__init__.py</i><br/>get_policy('chronos-inspired')"]

    runner["<b>Runner loop</b><br/><i>src/admitperf/harness/</i><br/>Per-request:<br/>read state, call decide, act"]

    stateCache["<b>State cache</b><br/><i>refreshed on engine tick</i><br/>Snapshot of KV%, queue depth,<br/>running req count, staleness age"]

    metrics["<b>Metrics collector</b><br/><i>src/admitperf/metrics/</i><br/>goodput, TTFT p95, TBT p95,<br/>admit/defer/reject counts"]

    bundle["<b>Results bundle writer</b><br/>SHA-256-signed manifest:<br/>config, trace, decisions,<br/>metrics, env"]
  end

  plugins["Policy plugins<br/>(external to Core)"]
  workloads["Workloads<br/>(external to Core)"]
  engine[/"Engine adapter<br/>(vLLM/SGLang /metrics)"/]
  disk[/"Local FS / S3 / R2"/]

  cli --> runner

  runner -- "1. read fresh state" --> stateCache
  runner -- "2. get policy by name" --> registry
  registry -- "returns instance implementing" --> api
  runner -- "3. call decide(req, state)" --> plugins
  plugins -- "implements" --> api
  runner -- "4. record decision" --> metrics
  runner -- "5. enqueue admitted / reject" --> engine

  engine -- "pushes tick" --> stateCache
  workloads -- "feeds requests" --> runner
  metrics -- "writes bundle" --> bundle
  bundle --> disk

